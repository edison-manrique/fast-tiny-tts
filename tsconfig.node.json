{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": false,
    "outDir": "./dist/node",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "types": ["node"],
    "sourceMap": false
  },
  "include": ["src/node/**/*.ts", "src/types.ts", "src/phonemizer.ts", "src/core.ts", "src/wav.ts"],
  "exclude": ["src/web/**/*", "node_modules"]
}
